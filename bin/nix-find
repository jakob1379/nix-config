#!/usr/bin/env bash

# Default to interactive mode
interactive=true

# Parse options
while getopts ":p" opt; do
	case ${opt} in
		p)
			interactive=false
			;;
		\?)
			echo "Invalid option: $OPTARG" 1>&2
			exit 1
			;;
	esac
done
shift $((OPTIND - 1))

queries=("$@")

if [[ "$interactive" == false ]]; then
	# Non-interactive mode: filter and print
	nix-search-tv print "${queries[@]}" | fzf --filter="${queries[*]}"
	exit 0
fi

# Helper: extract package names from selection lines
nix_find_extract_pkgs() {
	local pkgs=()
	local attr
	for sel in "$@"; do
		attr=$(echo "$sel" | awk -F'/ +' '{print $2}' | tr -d ' ')
		[[ -n "$attr" ]] && pkgs+=("$attr")
	done
	echo "${pkgs[*]}"
}
export -f nix_find_extract_pkgs

# Helper: percent-encode everything outside the URI unreserved set
nix_find_urlencode() {
	local out='' char i
	for ((i = 0; i < ${#1}; i++)); do
		char=${1:i:1}
		case $char in
			[-._~A-Za-z0-9]) out+=$char ;;
			*)
				printf -v char '%%%02X' "'$char"
				out+=$char
				;;
		esac
	done
	printf '%s' "$out"
}
export -f nix_find_urlencode

# Helper: Home-Manager options have no homepage of their own, so nix-search-tv
# falls back to the module source for both links. Send the homepage to the
# option search instead, on master, the branch nix-search-tv indexes.
nix_find_homepage() {
	local attr
	if [[ "$1" == home-manager/* ]]; then
		attr=${1#home-manager/}
		printf 'https://home-manager-options.extranix.com/?query=%s&release=master\n' \
			"$(nix_find_urlencode "${attr// /}")"
	else
		nix-search-tv homepage "$1"
	fi
}
export -f nix_find_homepage

# Helper: .override arguments as "f name" (has a default, i.e. a feature flag)
# or "d name" (dependency), after a "p file:line" line from meta.position;
# Nix cannot expose default values, so the preview reads them from that file
nix_find_overrides() {
	[[ "$1" == nixpkgs/* ]] || return 0
	# shellcheck disable=SC2016
	nix eval --raw "nixpkgs#$(nix_find_extract_pkgs "$1")" --apply '
		p: let a = p.override.__functionArgs; in
		"p ${p.meta.position or ""}\n"
		+ builtins.concatStringsSep "" (map (n: (if a.${n} then "f " else "d ") + n + "\n") (builtins.attrNames a))
	' 2>/dev/null
}
export -f nix_find_overrides

# Helper: preview with a homepage/source section under the title, so it
# stays above the fold for packages with long descriptions, and the override
# arguments in a right-hand column (stacked below when the pane is too narrow).
# awk runs bytewise so widths count UTF-8 lead bytes and skip ANSI codes.
# Flag defaults are the source text of "name ? default," formal lines, coloured
# by syntactic type; shortcut: one-line defaults in nixfmt layout only.
nix_find_preview() {
	local preview rest=""
	preview=$(nix-search-tv preview "$1")
	[[ "$preview" == *$'\n'* ]] && rest="${preview#*$'\n'}"
	nix_find_overrides "$1" | NIX_FIND_LEFT=$(printf '%s\n\n\033[1mhomepage/source\033[22m\n%s\n%s\n\n%s' \
		"${preview%%$'\n'*}" \
		"$(nix_find_homepage "$1")" \
		"$(nix-search-tv source "$1")" \
		"$rest") LC_ALL=C awk -v cols="${FZF_PREVIEW_COLUMNS:-0}" '
		function vis(s) { gsub(/\033\[[0-9;]*m/, "", s); gsub(/[\200-\277]/, "", s); return length(s) }
		function wrap(s,   out, w, k, sp, spw) {
			out = ""; w = 0; sp = 0
			while (s != "") {
				if (match(s, /^\033\[[0-9;]*m/)) k = 0
				else { match(s, /^.[\200-\277]*/); k = 1 }
				if (k && w == lw) {
					if (sp) { W[++m] = substr(out, 1, sp); out = substr(out, sp + 2); w -= spw + 1 }
					else { W[++m] = out; out = ""; w = 0 }
					sp = 0
				}
				if (k && substr(s, 1, 1) == " ") { sp = length(out); spw = w }
				out = out substr(s, 1, RLENGTH); w += k; s = substr(s, RLENGTH + 1)
			}
			W[++m] = out
		}
		function typed(v,   c) {
			if (vis(v) > 30) v = substr(v, 1, 29) "…"
			c = v ~ /^(true|false)$/ ? (v == "true" ? 32 : 31) : v == "null" ? 90 : v ~ /^"/ || index(v, "\047\047") == 1 ? 33 \
				: v ~ /^-?[0-9]/ ? 35 : v ~ /^[[{(]/ ? 36 : 34
			return "\033[" c "m" v "\033[39m"
		}
		$1 == "p" { file = $2; sub(/:[0-9]+$/, "", file) }
		$1 == "f" { f[++nflags] = $2; if (length($2) > nw) nw = length($2) }
		$1 == "d" { d[++ndeps] = $2 }
		END {
			if (file != "") while ((getline line < file) > 0) {
				if (line ~ /^[ \t]*}[ \t]*:/) break
				if (match(line, /^[ \t]*[A-Za-z_][A-Za-z0-9_-]*[ \t]*\?/)) {
					k = substr(line, 1, RLENGTH); gsub(/[ \t?]/, "", k)
					v = substr(line, RLENGTH + 1); sub(/^[ \t]+/, "", v); sub(/,?[ \t]*(#.*)?$/, "", v)
					if (!(k in def)) def[k] = v == "" ? "…" : v
				}
			}
			if (nflags) {
				R[++r] = "\033[1moverride flags\033[22m"
				for (i = 1; i <= nflags; i++) R[++r] = (f[i] in def) ? sprintf("%-" nw "s  %s", f[i], typed(def[f[i]])) : f[i]
			}
			if (nflags && ndeps) R[++r] = ""
			if (ndeps) { R[++r] = "\033[1moverride deps\033[22m"; for (i = 1; i <= ndeps; i++) R[++r] = "\033[2m" d[i] "\033[22m" }
			for (i = 1; i <= r; i++) if (vis(R[i]) > rw) rw = vis(R[i])
			n = split(ENVIRON["NIX_FIND_LEFT"], L, "\n")
			lw = cols - rw - 4
			if (!r || lw < 50) {
				for (i = 1; i <= n; i++) print L[i]
				if (r) { print ""; for (i = 1; i <= r; i++) print R[i] }
				exit
			}
			for (i = 1; i <= n; i++) wrap(L[i])
			for (i = 1; i <= m || i <= r; i++)
				printf "%s%s\033[0m \033[2m│\033[22m %s\n", W[i], sprintf("%" (lw - vis(W[i])) "s", ""), R[i]
		}
	'
}
export -f nix_find_preview

nix_find_comma() {
	local attr prog
	attr=$(nix_find_extract_pkgs "$1")
	prog=$(nix-search-tv preview "$1" | awk '
		/main program/ { f = 1; next }
		f && /^$/ { exit }
		f && match($0, /\$ [^ ]+/) { print substr($0, RSTART + 2, RLENGTH - 2); exit }
	')
	printf ', %q\n' "${prog:-${attr##*.}}"
}
export -f nix_find_comma

# Build info command for fzf (receives {+} as space-separated args)
# shellcheck disable=SC2016
info_cmd='echo "nix-shell -p $(nix_find_extract_pkgs {+})"'

# Interactive mode
mapfile -t selections < <(
	nix-search-tv print "${queries[@]}" \
		| fzf \
			--ansi \
			--multi \
			--query="${queries[*]}" \
			--prompt="❄ Query> " \
			--scheme=history \
			--preview-window=down:60%:wrap \
			--preview 'nix_find_preview {}' \
			--bind "enter:accept" \
			--bind "alt-enter:become(nix_find_comma {})" \
			--bind "alt-c:execute-silent(echo {} | awk -F'/ +' '{print \$2}' | tr -d ' ' | wl-copy 2>/dev/null || xclip -selection clipboard)" \
			--bind "alt-l:toggle-preview" \
			--header $'TAB mark • ENTER nix-shell • Alt-Enter comma • Alt-C copy • Alt-L toggle preview' \
			--info-command "$info_cmd"
)
status=$?

if ((status == 130)); then
	echo "Selection cancelled." >&2
	exit 130
elif ((${#selections[@]} == 0)); then
	echo "No package selected." >&2
	exit 0
fi

if [[ "${selections[0]}" == ,\ * ]]; then
	printf '%s\n' "${selections[0]}"
	exit 0
fi

# Extract package names using the same function
pkgs_str=$(nix_find_extract_pkgs "${selections[@]}")
IFS=' ' read -ra pkgs <<<"$pkgs_str"

printf 'nix-shell -p'
printf ' %q' "${pkgs[@]}"
printf '\n'
